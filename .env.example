# Copie este arquivo para .env e ajuste. O arquivo .env NUNCA vai para o GitHub.

# ---------- LLM ----------
# ollama = modelo local (gratuito, sem chave, nada sai da máquina)
# openai = API na nuvem compatível com OpenAI (exige chave)
# hf     = modelo local via transformers (use para testar o modelo ajustado com LoRA)
# mock   = resposta simulada, para testar sem modelo
LLM_PROVIDER=ollama

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Preencha só se LLM_PROVIDER=openai. Use o endereço e o nome de modelo do provedor escolhido.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Preencha só se LLM_PROVIDER=hf
HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct
HF_LORA=

LLM_TEMPERATURE=0.2
LLM_TIMEOUT=120

# ---------- STT ----------
# Tamanhos do Whisper: tiny, base, small, medium
STT_MODEL=small
STT_DEVICE=auto

# ---------- TTS ----------
# edge  = voz na nuvem (o TEXTO da resposta é enviado ao serviço)
# piper = voz local (exige o executável piper e um modelo .onnx)
TTS_ENGINE=edge
EDGE_VOICE=pt-BR-FranciscaNeural
PIPER_MODEL=

# ---------- Base de conhecimento ----------
CORPUS_TEXTO=dados/corpus/texto_puro.jsonl
RAG_TOP_K=3
RAG_SCORE_MINIMO=1.0

# ---------- Busca na web (genai) ----------
# Segunda fonte de evidência, usada só quando as fontes do INPE não cobrem a
# pergunta (ex.: telefone de emergência). Gratuita, sem chave de API (DuckDuckGo).
BUSCA_WEB_ATIVA=true
BUSCA_WEB_MAX_RESULTADOS=3

# ---------- Interface ----------
# GRADIO_SHARE=1 cria um link https temporário. É o jeito de usar o microfone no celular.
GRADIO_SHARE=0
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860
